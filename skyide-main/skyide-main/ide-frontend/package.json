{
  "name": "ide-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "ci": "cd .. && bash run-ci.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "backend": "cd ../api-backend && source venv/bin/activate && python3 app.py",
    "start": "concurrently \"npm run backend\" \"npm run dev\" --names \"BACKEND,FRONTEND\" --prefix name --kill-others --kill-others-on-fail",
    "start:dev": "concurrently \"npm run backend\" \"npm run dev\" --names \"🐍API,⚛️UI\" --prefix name --kill-others --kill-others-on-fail",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@blockly/field-colour": "^6.0.5",
    "blockly": "^12.3.1",
    "react": "18.3.1",
    "react-blockly": "^9.0.0",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-testing-library": "^7.1.0",
    "globals": "^16.4.0",
    "jsdom": "^25.0.1",
    "msw": "^2.6.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^2.1.8"
  }
}
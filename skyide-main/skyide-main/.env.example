# Copy to .env (gitignored) for the local Docker stack: cp .env.example .env
# LOCAL DEV ONLY. Production secrets are injected on the host by CI in phase 2 —
# never commit real secrets here.

# Postgres password (used by both the db and backend services).
DB_PASSWORD=change-me

# Flask SECRET_KEY — also used for JWT signing when JWT_SECRET_KEY is unset.
SECRET_KEY=change-me

# Browser origin(s) allowed by the backend. With the nginx /api proxy this is
# same-origin, so CORS isn't exercised; set to match the published frontend port.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Resend transactional-email API key (powers the contact-us form). Optional locally —
# leave blank and contact-us just won't send. In production it's injected on the host by
# CI from the RESEND_API_KEY CI/CD variable (see .gitlab-ci.yml `deploy`).
RESEND_API_KEY=

# PRODUCTION ONLY (docker-compose.prod.yml) — generated on the ct03 host by CI, not used
# locally. Pins the image tag the prod stack pulls; defaults to `latest` when unset.
# IMAGE_TAG=latest